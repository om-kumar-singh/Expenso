<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:orientation="vertical"
    tools:context=".PeriodActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/period_title"
        android:textColor="@color/ink"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/accountFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_rounded_surface"
        android:drawableEnd="@drawable/ic_chevron_down"
        android:elevation="2dp"
        android:fontFamily="sans-serif-medium"
        android:padding="12dp"
        android:textColor="@color/ink"
        android:textSize="15sp"
        tools:text="All accounts" />

    <TextView
        android:id="@+id/startDateValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_rounded_surface"
        android:elevation="2dp"
        android:padding="12dp"
        android:textColor="@color/ink"
        android:textSize="15sp"
        tools:text="Start: 15 Sep 2026" />

    <TextView
        android:id="@+id/endDateValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_rounded_surface"
        android:elevation="2dp"
        android:padding="12dp"
        android:textColor="@color/ink"
        android:textSize="15sp"
        tools:text="End: 19 Sep 2026" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/calculatePeriodButton"
        style="@style/Widget.ExpensesByOm.CalculateButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/calculate_period" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/rangeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/totalExpenses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/totalReceived"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/totalNet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/transactionCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/ink_muted"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/perAccountList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/card_radius"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fillViewport="true">

                    <TableLayout
                        android:id="@+id/transactionTable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:shrinkColumns="1,2"
                        android:stretchColumns="2" />
                </HorizontalScrollView>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/include_bottom_nav" />
</LinearLayout>
